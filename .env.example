# Local dev uses SQLite so the app runs with zero infrastructure.
# For Postgres: change provider in prisma/schema.prisma to "postgresql" and set
# DATABASE_URL="postgresql://user:pass@localhost:5432/medianet_smb"
DATABASE_URL="file:./dev.db"

# Demo clock speed: simulated seconds per real second (120 => one simulated day every 12 real minutes)
SIM_SPEED=120

# Channel adapter: "mock" (only option in MVP)
CHANNEL_ADAPTER=mock
# Probability (0-1) that a mock adapter command fails, to exercise retries/fallbacks
MOCK_ADAPTER_FAILURE_RATE=0
